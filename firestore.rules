
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════
    // HELPER FUNCTIONS
    // ══════════════════════════════════════════

    function isAuthed() {
      return request.auth != null;
    }

    function staffDoc(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)/staff/$(request.auth.uid));
    }

    function getRole(schoolId) {
      return staffDoc(schoolId).data.role;
    }

    function isStaff(schoolId) {
      return isAuthed() && (
        exists(/databases/$(database)/documents/schools/$(schoolId)/staff/$(request.auth.uid)) ||
        request.auth.token.email == 'admin@shule.pro' ||
        (schoolId == 'school-001' && request.auth.token.firebase.sign_in_provider == 'anonymous')
      );
    }

    function isActive(schoolId) {
      // For demo accounts, we check if it's the official admin email or anonymous demo node
      return isStaff(schoolId);
    }

    function isAdmin(schoolId) {
      return isActive(schoolId) && (
        getRole(schoolId) == 'ADMIN' ||
        request.auth.token.email == 'admin@shule.pro' ||
        (schoolId == 'school-001' && request.auth.token.firebase.sign_in_provider == 'anonymous')
      );
    }

    function isTeacher(schoolId) {
      return isActive(schoolId) && (getRole(schoolId) in ['ADMIN', 'TEACHER']);
    }

    function isAccountant(schoolId) {
      return isActive(schoolId) && (getRole(schoolId) in ['ADMIN', 'ACCOUNTANT', 'BURSAR']);
    }

    // ══════════════════════════════════════════
    // STAFF MAPPING (Global lookup)
    // ══════════════════════════════════════════

    match /staffMappings/{uid} {
      allow read: if isAuthed() && request.auth.uid == uid;
      allow write: if false;
    }

    // ══════════════════════════════════════════
    // SCHOOL DOCUMENT HIERARCHY
    // ══════════════════════════════════════════

    match /schools/{schoolId} {
      allow read: if isActive(schoolId);
      allow write: if isAdmin(schoolId);

      match /staff/{staffId} {
        allow read: if isActive(schoolId);
        allow write: if isAdmin(schoolId);
      }

      match /students/{studentId} {
        allow read: if isActive(schoolId);
        allow create, update: if isTeacher(schoolId) || isAdmin(schoolId);
        allow delete: if isAdmin(schoolId);
      }

      match /transactions/{txId} {
        allow read: if isAccountant(schoolId) || isAdmin(schoolId);
        allow create, update: if isAccountant(schoolId) || isAdmin(schoolId);
        allow delete: if false; // Forensic Ledger - No Deletion
      }

      match /attendance/{recordId} {
        allow read: if isActive(schoolId);
        allow create, update: if isTeacher(schoolId) || isAdmin(schoolId);
        allow delete: if false;
      }

      match /grades/{gradeId} {
        allow read: if isActive(schoolId);
        allow create, update: if isTeacher(schoolId) || isAdmin(schoolId);
        allow delete: if isAdmin(schoolId);
      }
      
      match /syllabus_tracking/{docId} {
        allow read: if isActive(schoolId);
        allow write: if isTeacher(schoolId) || isAdmin(schoolId);
      }

      match /config/{configDoc} {
        allow read: if isActive(schoolId);
        allow write: if isAdmin(schoolId);
      }

      match /assets/{assetId} {
        allow read: if isActive(schoolId);
        allow write: if isAdmin(schoolId) || isAccountant(schoolId);
      }

      match /hostels/{id} { allow read, write: if isStaff(schoolId); }
      match /routes/{id} { allow read, write: if isStaff(schoolId); }
      match /canteen_sales/{id} { allow read, write: if isStaff(schoolId); }
      match /timetable/{id} { allow read, write: if isTeacher(schoolId) || isAdmin(schoolId); }

      // Explicit deny for any unknown subcollection
      match /{otherCollection}/{docId} {
        allow read: if isActive(schoolId);
        allow write: if isAdmin(schoolId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
