
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Institutional Security Helpers
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Membership helper: checks for the schoolId claim in the token.
     * Fallback: Allows access to 'school-001' for verified institutional emails.
     */
    function isMember(schoolId) {
      return isSignedIn() && (
        request.auth.token.schoolId == schoolId || 
        (schoolId == 'school-001' && (
          request.auth.token.email.endsWith('@shule.pro') || 
          request.auth.token.email == 'admin@shule.pro'
        ))
      );
    }

    /**
     * Role helper: checks for the role claim in the token.
     * Fallback: Identifies the primary admin email as an ADMIN.
     */
    function hasRole(role) {
      return isSignedIn() && (
        request.auth.token.role == role ||
        (role == 'ADMIN' && request.auth.token.email == 'admin@shule.pro')
      );
    }

    function isAdmin() {
      return hasRole('ADMIN');
    }

    function isTeacher() {
      return hasRole('TEACHER');
    }

    function isAccountant() {
      return hasRole('ACCOUNTANT') || hasRole('BURSAR');
    }

    match /schools/{schoolId} {
      // 1. Allow authenticated members to read all data under their school node.
      allow read: if isMember(schoolId);
      
      // Recursive read for all school sub-collections
      match /{allPaths=**} {
        allow read: if isMember(schoolId);
      }

      // 2. Allow admin users to write (create/update) all data.
      match /students/{studentId} {
        allow create, update: if isMember(schoolId) && isAdmin();
        // 6. Never allow delete of student identities.
        allow delete: if false;
      }

      match /staff/{staffId} {
        allow write: if isMember(schoolId) && isAdmin();
      }

      match /attendance/{docId} {
        allow write: if isMember(schoolId) && (isAdmin() || isTeacher());
      }

      match /syllabus_tracking/{docId} {
        allow write: if isMember(schoolId) && (isAdmin() || isTeacher());
      }

      match /academics/{docId} {
        allow write: if isMember(schoolId) && (isAdmin() || isTeacher());
      }

      match /transactions/{transactionId} {
        allow create, update: if isMember(schoolId) && (isAdmin() || isAccountant());
        // 5. Never allow delete of forensic financial records.
        allow delete: if false;
      }

      match /petty_cash/{expenseId} {
        allow create, update: if isMember(schoolId) && (isAdmin() || isAccountant());
        allow delete: if isMember(schoolId) && isAdmin();
      }

      match /assets/{assetId} {
        allow create, update: if isMember(schoolId) && (isAdmin() || isAccountant());
        allow delete: if isMember(schoolId) && isAdmin();
      }

      match /hostels/{hostelId} {
        allow create, update: if isMember(schoolId) && (isAdmin() || isAccountant());
        allow delete: if isMember(schoolId) && isAdmin();
      }

      match /routes/{routeId} {
        allow create, update: if isMember(schoolId) && (isAdmin() || isAccountant());
        allow delete: if isMember(schoolId) && isAdmin();
      }

      match /canteen_sales/{saleId} {
        allow create, update: if isMember(schoolId) && (isAdmin() || isAccountant());
        allow delete: if isMember(schoolId) && isAdmin();
      }

      match /config/{configId} {
        allow write: if isMember(schoolId) && isAdmin();
      }
    }
  }
}
