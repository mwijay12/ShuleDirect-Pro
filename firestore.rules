
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Financial Integrity Helper
    function isValidPaymentUpdate() {
      let student = resource.data;
      let newStudent = request.resource.data;
      // Balance MUST equal (Expected + Arrears) - TotalPaid
      return newStudent.balance == (newStudent.totalFeesExpected + newStudent.arrears) - newStudent.totalPaid;
    }

    match /schools/{schoolId} {
      allow read, write: if isSignedIn();

      match /students/{studentId} {
        allow read: if isSignedIn();
        // Prevent manual tampering with the balance outside of transaction logic
        allow update: if isSignedIn() && isValidPaymentUpdate();
        allow create: if isSignedIn();
        allow delete: if isSignedIn();

        match /payments/{paymentId} {
          allow read, write: if isSignedIn();
        }
      }

      match /assets/{assetId} {
        allow read, write: if isSignedIn();
      }

      match /hostels/{hostelId} {
        allow read, write: if isSignedIn();
      }

      match /config/{configId} {
        allow read, write: if isSignedIn();
      }
    }
  }
}
