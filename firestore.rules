rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * SHULEDIRECT PRO: MULTI-TENANT ASSET MANAGEMENT SECURITY RULES
     *
     * Core Philosophy:
     * This ruleset enforces a strict multi-tenant architecture where the primary boundary 
     * is the School entity. All data (Users, Assets, Maintenance Logs) is nested under 
     * a specific /schools/{schoolId} path. Authorization is primarily handled through 
     * Database Access Control (DBAC) by looking up the authenticated user's role 
     * within their specific school's user collection.
     *
     * Data Structure:
     * - /schools/{schoolId}: Tenant root.
     * - /schools/{schoolId}/users/{userId}: School-specific user profiles and roles.
     * - /schools/{schoolId}/assets/{assetId}: Physical assets belonging to a school.
     * - /schools/{schoolId}/assets/{assetId}/maintenanceLogs/{logId}: Maintenance history.
     *
     * Key Security Decisions:
     * 1. Multi-Tenancy: Access is strictly gated by the schoolId in the URL path. 
     *    Users must have a valid profile document within that school's 'users' 
     *    subcollection to gain access.
     * 2. Role-Based Access: Higher-level permissions (creating assets, viewing logs) 
     *    require roles such as 'SchoolOwner', 'Headmaster', or 'MaintenanceStaff'.
     * 3. QR Code Scanning: Assets are readable by any authenticated member of the school 
     *    to facilitate instant lookup via scanned QR code values.
     * 4. Denormalization for Performance: To avoid excessive get() calls, maintenance logs 
     *    are expected to contain the performer's role and schoolId for validation during creation.
     */

    // --- Helper Functions ---

    /** Checks if a user is authenticated. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** Returns the user document for the current authenticated user within a specific school. */
    function getUserData(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid)).data;
    }

    /** Checks if the user is a registered member of the specific school. */
    function isMember(schoolId) {
      return isSignedIn() && exists(/databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid));
    }

    /** Checks if the user has a specific role within the school. */
    function hasRole(schoolId, role) {
      return isMember(schoolId) && getUserData(schoolId).role == role;
    }

    /** Checks if the user is the owner of the document ID (typically for user profiles). */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** Verifies a document exists before update or delete. */
    function isExisting() {
      return resource != null;
    }

    // --- Rules ---

    /**
     * @description Rules for the School root entity.
     * @path /schools/{schoolId}
     * @allow Authenticated members of the school (get), SchoolOwner (update).
     * @deny Non-members (list/get), Standard users (write).
     * @principle Ensures multi-tenant isolation at the root level.
     */
    match /schools/{schoolId} {
      allow get: if isMember(schoolId);
      allow list: if isSignedIn(); // Filtered by application logic, but members must be able to list their own school.
      allow create: if isSignedIn(); // Prototyping: Allow creation, ideally restricted to a Global Admin.
      allow update: if isExisting() && hasRole(schoolId, 'SchoolOwner');
      allow delete: if false; // Destructive school removal is disabled.

      /**
       * @description User profiles within a school.
       * @path /schools/{schoolId}/users/{userId}
       * @allow Owner to read/write self; SchoolOwner/Headmaster to read others.
       * @deny Users writing to other people's profiles.
       * @principle Combines Ownership and Role-based access.
       */
      match /users/{userId} {
        allow get: if isOwner(userId) || hasRole(schoolId, 'SchoolOwner') || hasRole(schoolId, 'Headmaster');
        allow list: if isMember(schoolId); 
        allow create: if isOwner(userId); // Users create their own profile during onboarding.
        allow update: if isExisting() && isOwner(userId);
        allow delete: if false; // Users cannot delete their profiles for audit integrity.
      }

      /**
       * @description School assets for inventory and QR tracking.
       * @path /schools/{schoolId}/assets/{assetId}
       * @allow Any school member to read (for QR scanning); Management/Maintenance to write.
       * @deny Users from other schools.
       * @principle Tenant-scoped access for operational data.
       */
      match /assets/{assetId} {
        allow get, list: if isMember(schoolId);
        allow create: if isMember(schoolId) && request.resource.data.schoolId == schoolId;
        allow update: if isExisting() && isMember(schoolId) && request.resource.data.schoolId == resource.data.schoolId;
        allow delete: if isExisting() && (hasRole(schoolId, 'SchoolOwner') || hasRole(schoolId, 'Headmaster'));

        /**
         * @description Maintenance logs for a specific asset.
         * @path /schools/{schoolId}/assets/{assetId}/maintenanceLogs/{logId}
         * @allow Members to read history; MaintenanceStaff/Owners to create.
         * @deny Maintenance staff from other schools.
         * @principle Authorization Independence via denormalized role checks.
         */
        match /maintenanceLogs/{logId} {
          allow get, list: if isMember(schoolId);
          
          // Validation: Enforce that the creator is the actual performer and belongs to the school.
          allow create: if isSignedIn() 
            && request.resource.data.performedByUserId == request.auth.uid 
            && request.resource.data.schoolId == schoolId
            && (hasRole(schoolId, 'MaintenanceStaff') || hasRole(schoolId, 'SchoolOwner'));

          // Maintenance logs should generally be immutable for audit purposes.
          allow update: if isExisting() && hasRole(schoolId, 'SchoolOwner');
          allow delete: if isExisting() && hasRole(schoolId, 'SchoolOwner');
        }
      }
    }
  }
}