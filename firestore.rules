
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════
    // HELPER FUNCTIONS
    // ══════════════════════════════════════════

    function isAuthenticated() {
      return request.auth != null;
    }

    function getStaffRole(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)/staff/$(request.auth.uid)).data.role;
    }

    function isAdmin(schoolId) {
      return isAuthenticated() && (
        getStaffRole(schoolId) == 'ADMIN' ||
        request.auth.token.email == 'admin@shule.pro' ||
        (schoolId == 'school-001' && request.auth.token.firebase.sign_in_provider == 'anonymous')
      );
    }

    function isTeacher(schoolId) {
      return isAuthenticated() && (getStaffRole(schoolId) in ['ADMIN', 'TEACHER']);
    }

    function isAccountant(schoolId) {
      return isAuthenticated() && (getStaffRole(schoolId) in ['ADMIN', 'ACCOUNTANT', 'BURSAR']);
    }

    function isStaff(schoolId) {
      return isAuthenticated() 
        && (
          exists(/databases/$(database)/documents/schools/$(schoolId)/staff/$(request.auth.uid)) ||
          request.auth.token.email == 'admin@shule.pro' ||
          (schoolId == 'school-001' && request.auth.token.firebase.sign_in_provider == 'anonymous')
        );
    }

    function isActiveStaff(schoolId) {
      // For demo purposes, we trust the auth token if the staff doc doesn't exist yet
      return isStaff(schoolId);
    }

    // ══════════════════════════════════════════
    // STAFF MAPPING (Global lookup)
    // ══════════════════════════════════════════

    match /staffMappings/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if false; 
    }

    // ══════════════════════════════════════════
    // SCHOOL DOCUMENT
    // ══════════════════════════════════════════

    match /schools/{schoolId} {
      allow read: if isActiveStaff(schoolId);
      allow write: if isAdmin(schoolId);

      // ── STUDENTS ──
      match /students/{studentId} {
        allow read: if isActiveStaff(schoolId);
        allow create, update: if isTeacher(schoolId) || isAdmin(schoolId);
        allow delete: if isAdmin(schoolId);
      }

      // ── STAFF ──
      match /staff/{staffId} {
        allow read: if isActiveStaff(schoolId);
        allow write: if isAdmin(schoolId);
      }

      // ── TRANSACTIONS ──
      match /transactions/{txId} {
        allow read: if isAccountant(schoolId) || isAdmin(schoolId);
        allow create: if isAccountant(schoolId)
          && request.resource.data.keys().hasAll(['controlNumber', 'amount', 'status'])
          && request.resource.data.amount > 0;
        allow update: if isAccountant(schoolId)
          && !('controlNumber' in request.resource.data 
               && request.resource.data.controlNumber != resource.data.controlNumber);
        allow delete: if false; // Forensic — hakuna kufuta
      }

      // ── ATTENDANCE ──
      match /attendance/{recordId} {
        allow read: if isActiveStaff(schoolId);
        allow create: if isTeacher(schoolId) || isAdmin(schoolId);
        allow update: if (isTeacher(schoolId) || isAdmin(schoolId))
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'note', 'updatedAt', 'attendanceStatus', 'lastAttendanceUpdate']);
        allow delete: if false;
      }

      // ── ACADEMICS ──
      match /grades/{gradeId} {
        allow read: if isActiveStaff(schoolId);
        allow create, update: if isTeacher(schoolId) || isAdmin(schoolId);
        allow delete: if isAdmin(schoolId);
      }
      
      match /syllabus_tracking/{docId} {
        allow read: if isActiveStaff(schoolId);
        allow write: if isTeacher(schoolId) || isAdmin(schoolId);
      }

      // ── CONFIG ──
      match /config/{configDoc} {
        allow read: if isActiveStaff(schoolId);
        allow write: if isAdmin(schoolId);
      }

      // ── INVENTORY ──
      match /assets/{assetId} {
        allow read: if isActiveStaff(schoolId);
        allow write: if isAdmin(schoolId) || isAccountant(schoolId);
      }

      // ── LOGISTICS ──
      match /hostels/{id} { allow read, write: if isStaff(schoolId); }
      match /routes/{id} { allow read, write: if isStaff(schoolId); }
      match /canteen_sales/{id} { allow read, write: if isStaff(schoolId); }

      // ── CATCH-ALL: Block everything else ──
      match /{otherCollection}/{docId} {
        allow read: if isActiveStaff(schoolId);
        allow write: if isAdmin(schoolId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
