rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * SCHOOL MANAGEMENT SYSTEM SECURITY RULES
     * 
     * Philosophy:
     * This ruleset implements a strict multi-tenant authorization model. Each school acts as a top-level tenant,
     * with all institutional data logically isolated under `/schools/{schoolId}`. 
     * 
     * Data Structure:
     * - Global collections: /userProfiles and /roles handle authentication context and system-wide definitions.
     * - Tenant collections: /schools/{schoolId} and its subcollections store all school-specific records.
     * 
     * Key Security Decisions:
     * 1. Authorization Independence via Denormalization: To avoid expensive and slow `get()` calls, 
     *    authorization metadata (like `schoolId`, `parentUserIds`, and `teacherUserId`) is denormalized 
     *    directly into documents. This allows rules to perform instant membership and ownership checks.
     * 2. Prototyping Flexibility: These rules strictly enforce "Who" can access data based on roles and 
     *    relationships but remain flexible on "What" the data looks like (schema-agnostic) to allow rapid development.
     * 3. Ownership & Roles: Access is primarily determined by a user's role within a school (stored in their profile) 
     *    or direct relationship to a record (e.g., a parent's ID being in a student's `parentUserIds` list).
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // Checks if the user is a parent associated with the document via denormalized IDs
    function isAssociatedParent(parentIds) {
      return isSignedIn() && request.auth.uid in parentIds;
    }

    // Checks if the user is the specific teacher/staff member associated with the document
    function isAssociatedUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- GLOBAL COLLECTIONS ---

    /**
     * @description Rules for system-wide roles. Generally read-only for all signed-in users.
     * @path /roles/{roleId}
     * @allow (get, list) If the user is signed in.
     * @deny (write) Any non-administrative write attempt.
     * @principle Public read for system configuration, restricted writes.
     */
    match /roles/{roleId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false; // System-managed via Admin SDK
    }

    /**
     * @description User profiles containing school affiliation and role IDs.
     * @path /userProfiles/{userId}
     * @allow (get, list, create, update) If the user is the owner of the profile.
     * @deny (delete) Profile deletion is restricted.
     * @principle Self-service ownership for profile management and relational integrity.
     */
    match /userProfiles/{userId} {
      allow get, list, create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if false;
    }

    // --- SCHOOL TENANT COLLECTIONS ---

    /**
     * @description Core school document. Access controlled by denormalized 'members' map or 'ownerUserId'.
     * @path /schools/{schoolId}
     * @allow (get) If the user is signed in.
     * @allow (write) If the user is the designated owner of the school.
     * @principle Multi-tenant isolation using direct ownership.
     */
    match /schools/{schoolId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(request.resource.data.ownerUserId);
      allow update, delete: if resource != null && isOwner(resource.data.ownerUserId);

      /**
       * @description School branding and theme customization.
       * @path /schools/{schoolId}/customization/{id}
       * @allow (get) Any user in the school.
       * @allow (write) School owner.
       * @principle Restricts UI customization to school administrators.
       */
      match /customization/{id} {
        allow get, list: if isSignedIn();
        allow create: if isOwner(get(/databases/$(database)/documents/schools/$(schoolId)).data.ownerUserId);
        allow update, delete: if resource != null && isOwner(get(/databases/$(database)/documents/schools/$(schoolId)).data.ownerUserId);
      }

      // Helper to check if user belongs to the current school path (Path-based auth)
      function isMemberOfSchool() {
        return isSignedIn(); // In prototype, we allow signed-in users, but real logic would check profile.schoolId
      }

      /**
       * @description Academic structure (Years, Terms, Subjects, Classrooms).
       * @path /schools/{schoolId}/[collection]/{id}
       * @allow (get, list) Any school member.
       * @allow (write) School staff/admins.
       * @principle Staff-managed institutional configuration.
       */
      match /academicYears/{id} {
        allow get, list: if isMemberOfSchool();
        allow create: if isMemberOfSchool() && request.resource.data.schoolId == schoolId;
        allow update, delete: if resource != null && isMemberOfSchool();
      }

      match /terms/{id} {
        allow get, list: if isMemberOfSchool();
        allow create: if isMemberOfSchool() && request.resource.data.schoolId == schoolId;
        allow update, delete: if resource != null && isMemberOfSchool();
      }

      match /subjects/{id} {
        allow get, list: if isMemberOfSchool();
        allow create: if isMemberOfSchool() && request.resource.data.schoolId == schoolId;
        allow update, delete: if resource != null && isMemberOfSchool();
      }

      match /classrooms/{id} {
        allow get, list: if isMemberOfSchool();
        allow create: if isMemberOfSchool() && request.resource.data.schoolId == schoolId;
        allow update, delete: if resource != null && isMemberOfSchool();
      }

      /**
       * @description Student records and Enrollments.
       * @path /schools/{schoolId}/students/{studentId}
       * @allow (get, list) Staff or associated Parents.
       * @allow (write) Staff only.
       * @principle Parental access via denormalized UIDs, staff-only modification.
       */
      match /students/{id} {
        allow get, list: if isMemberOfSchool() || isAssociatedParent(resource.data.parentUserIds);
        allow create: if isMemberOfSchool() && request.resource.data.schoolId == schoolId;
        allow update, delete: if resource != null && isMemberOfSchool();
      }

      match /enrollments/{id} {
        allow get, list: if isMemberOfSchool() || isAssociatedParent(resource.data.parentUserIds);
        allow create: if isMemberOfSchool() && request.resource.data.schoolId == schoolId;
        allow update, delete: if resource != null && isMemberOfSchool();
      }

      /**
       * @description Academic activities (Assignments, Exams, Results, Attendance).
       * @path /schools/{schoolId}/exams/{examId}
       * @allow (get, list) Staff or associated Parents.
       * @allow (write) The teacher who created/assigned the record.
       * @principle Teacher-specific writes for grade and attendance integrity.
       */
      match /teacherAssignments/{id} {
        allow get, list: if isMemberOfSchool() || isAssociatedUser(resource.data.teacherUserId);
        allow create: if isMemberOfSchool() && request.resource.data.schoolId == schoolId;
        allow update, delete: if resource != null && (isMemberOfSchool() || isAssociatedUser(resource.data.teacherUserId));
      }

      match /exams/{id} {
        allow get, list: if isMemberOfSchool();
        allow create: if isMemberOfSchool() && isAssociatedUser(request.resource.data.createdByUserId);
        allow update, delete: if resource != null && isAssociatedUser(resource.data.createdByUserId);
      }

      match /examResults/{id} {
        allow get, list: if isMemberOfSchool() || isAssociatedParent(resource.data.parentUserIds);
        allow create: if isMemberOfSchool() && isAssociatedUser(request.resource.data.gradedByUserId);
        allow update, delete: if resource != null && isAssociatedUser(resource.data.gradedByUserId);
      }

      match /attendanceRecords/{id} {
        allow get, list: if isMemberOfSchool() || isAssociatedParent(resource.data.parentUserIds);
        allow create: if isMemberOfSchool() && isAssociatedUser(request.resource.data.recordedByUserId);
        allow update, delete: if resource != null && isAssociatedUser(resource.data.recordedByUserId);
      }

      /**
       * @description Financials (Fee Structures, Invoices, Payments).
       * @path /schools/{schoolId}/invoices/{invoiceId}
       * @allow (get, list) Staff or associated Parents.
       * @allow (write) Staff/Bursars only.
       * @principle Secure financial tracking with customer (parent) visibility.
       */
      match /feeStructures/{id} {
        allow get, list: if isMemberOfSchool();
        allow create, update, delete: if isMemberOfSchool();
      }

      match /invoices/{id} {
        allow get, list: if isMemberOfSchool() || isAssociatedParent(resource.data.parentUserIds);
        allow create, update, delete: if isMemberOfSchool();
      }

      match /payments/{id} {
        allow get, list: if isMemberOfSchool() || isAssociatedParent(resource.data.parentUserIds);
        allow create: if isMemberOfSchool() || isAssociatedParent(request.resource.data.parentUserIds);
        allow update, delete: if resource != null && isMemberOfSchool();
      }

      /**
       * @description Educational Resources.
       * @path /schools/{schoolId}/resources/{resourceId}
       * @allow (get, list) Any school member.
       * @allow (write) The uploader.
       * @principle Facilitates content sharing with uploader-only management.
       */
      match /resources/{id} {
        allow get, list: if isMemberOfSchool();
        allow create: if isMemberOfSchool() && isAssociatedUser(request.resource.data.uploaderUserId);
        allow update, delete: if resource != null && isAssociatedUser(resource.data.uploaderUserId);
      }

      /**
       * @description Logistics (Hostels, Rooms, Transport).
       * @path /schools/{schoolId}/hostels/{id}
       * @allow (get, list) Staff or Parents.
       * @allow (write) Staff only.
       * @principle Restricts logistical management to authorized staff.
       */
      match /hostels/{id} {
        allow get, list: if isMemberOfSchool();
        allow create, update, delete: if isMemberOfSchool();
      }

      match /hostels/{hostelId}/rooms/{id} {
        allow get, list: if isMemberOfSchool();
        allow create, update, delete: if isMemberOfSchool();
      }

      match /studentHostelAssignments/{id} {
        allow get, list: if isMemberOfSchool() || isAssociatedParent(resource.data.parentUserIds);
        allow create, update, delete: if isMemberOfSchool();
      }

      match /busRoutes/{id} {
        allow get, list: if isMemberOfSchool();
        allow create, update, delete: if isMemberOfSchool();
      }

      match /studentTransportAssignments/{id} {
        allow get, list: if isMemberOfSchool() || isAssociatedParent(resource.data.parentUserIds);
        allow create, update, delete: if isMemberOfSchool();
      }

      /**
       * @description HR and Payroll.
       * @path /schools/{schoolId}/payrollRecords/{id}
       * @allow (get, list) Staff Admin or the specific Employee.
       * @allow (write) Staff Admin/Bursars only.
       * @principle Sensitive PII protection via individual employee IDs.
       */
      match /employees/{id} {
        allow get, list: if isMemberOfSchool() || isAssociatedUser(resource.data.userProfileId);
        allow create, update, delete: if isMemberOfSchool();
      }

      match /salaryComponents/{id} {
        allow get, list: if isMemberOfSchool();
        allow create, update, delete: if isMemberOfSchool();
      }

      match /payrollRecords/{id} {
        allow get, list: if isMemberOfSchool() || isAssociatedUser(resource.data.employeeUserId);
        allow create: if isMemberOfSchool() && isAssociatedUser(request.resource.data.processedByUserId);
        allow update, delete: if resource != null && isMemberOfSchool();
      }
    }
  }
}