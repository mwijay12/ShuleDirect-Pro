
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email.matches('.*admin.*');
    }

    // Financial Integrity Helper: Prevent manual tampering with balances
    function isValidStudentUpdate() {
      let student = resource.data;
      let newStudent = request.resource.data;
      
      // If balance or totalPaid is changing, ensure it's not a direct write unless by admin
      // In a strict forensic mode, only the Finance Engine (Transactions) should change these.
      return (newStudent.balance == student.balance && newStudent.totalPaid == student.totalPaid) || isAdmin();
    }

    match /schools/{schoolId} {
      allow read, write: if isSignedIn();

      match /students/{studentId} {
        allow read: if isSignedIn();
        allow update: if isSignedIn() && isValidStudentUpdate();
        allow create: if isSignedIn();
        allow delete: if isAdmin();
      }

      match /transactions/{transactionId} {
        allow read: if isSignedIn();
        // Transactions are immutable once verified
        allow create: if isSignedIn();
        allow update: if isSignedIn() && resource.data.status != 'Verified' || isAdmin();
        allow delete: if isAdmin();
      }

      match /petty_cash/{expenseId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isAdmin();
      }

      match /config/{configId} {
        allow read, write: if isSignedIn();
      }
    }
  }
}
