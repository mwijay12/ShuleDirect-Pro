
{
  "entities": {
    "School": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "School",
      "type": "object",
      "description": "Represents a school, which acts as a distinct tenant within the multi-tenant system.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the School entity (Tenant ID)."
        },
        "name": {
          "type": "string",
          "description": "The official name of the school."
        },
        "address": {
          "type": "string",
          "description": "The physical address of the school."
        },
        "contactEmail": {
          "type": "string",
          "description": "The primary contact email address for the school.",
          "format": "email"
        },
        "contactPhone": {
          "type": "string",
          "description": "The primary contact phone number for the school."
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user account within the school management system with defined roles and access permissions.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity."
        },
        "schoolId": {
          "type": "string",
          "description": "Reference to the School the user is associated with."
        },
        "firstName": {
          "type": "string",
          "description": "The first name of the user."
        },
        "lastName": {
          "type": "string",
          "description": "The last name of the user."
        },
        "email": {
          "type": "string",
          "description": "The primary email address of the user.",
          "format": "email"
        },
        "role": {
          "type": "string",
          "description": "The assigned role (e.g., 'ADMIN', 'BURSAR', 'TEACHER')."
        }
      },
      "required": [
        "id",
        "schoolId",
        "firstName",
        "lastName",
        "email",
        "role"
      ]
    },
    "Asset": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Asset",
      "type": "object",
      "description": "Represents a physical asset owned by the school.",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "qrCodeValue": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "location": { "type": "string" },
        "status": { "type": "string" },
        "condition": { "type": "string" }
      },
      "required": [
        "id",
        "schoolId",
        "name",
        "qrCodeValue",
        "status"
      ]
    },
    "Hostel": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Hostel",
      "type": "object",
      "description": "Represents a residential wing or dormitory block.",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "name": { "type": "string" },
        "block": { "type": "string" },
        "type": { "type": "string", "enum": ["Boys", "Girls"] },
        "capacity": { "type": "number" },
        "occupied": { "type": "number" },
        "rooms": { "type": "number" },
        "warden": { "type": "string" },
        "safetyScore": { "type": "number" }
      },
      "required": [
        "id",
        "schoolId",
        "name",
        "block",
        "type"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/schools/{schoolId}",
        "definition": {
          "entityName": "School",
          "schema": { "$ref": "#/backend/entities/School" },
          "description": "Root tenant collection."
        }
      },
      {
        "path": "/schools/{schoolId}/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "Staff profiles."
        }
      },
      {
        "path": "/schools/{schoolId}/assets/{assetId}",
        "definition": {
          "entityName": "Asset",
          "schema": { "$ref": "#/backend/entities/Asset" },
          "description": "Institutional property."
        }
      },
      {
        "path": "/schools/{schoolId}/hostels/{hostelId}",
        "definition": {
          "entityName": "Hostel",
          "schema": { "$ref": "#/backend/entities/Hostel" },
          "description": "Dormitory wings."
        }
      },
      {
        "path": "/schools/{schoolId}/config/{configId}",
        "definition": {
          "entityName": "SystemConfig",
          "schema": { "type": "object" },
          "description": "Utility and system configurations."
        }
      }
    ]
  }
}
