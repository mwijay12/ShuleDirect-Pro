
{
  "entities": {
    "School": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "School",
      "type": "object",
      "description": "Represents a single school, which acts as a tenant in the multi-tenant system. It holds core institutional information.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "motto": { "type": "string" },
        "address": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "address", "phoneNumber", "email", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents an individual user account.",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "roleIds": { "type": "array", "items": { "type": "string" } },
        "isActive": { "type": "boolean" }
      }
    },
    "Asset": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Asset",
      "type": "object",
      "description": "Institutional property tracking (Inventory).",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["Laboratory", "Furniture", "ICT", "Library", "General"] },
        "code": { "type": "string" },
        "condition": { "type": "string", "enum": ["New", "Good", "Fair", "Poor", "Broken"] },
        "location": { "type": "string" },
        "purchasedDate": { "type": "string", "format": "date" }
      },
      "required": ["id", "schoolId", "name", "code", "condition"]
    },
    "MedicalRecord": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "MedicalRecord",
      "type": "object",
      "description": "Sickbay and health logs for students.",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "visitDate": { "type": "string", "format": "date-time" },
        "symptoms": { "type": "string" },
        "diagnosis": { "type": "string" },
        "treatment": { "type": "string" },
        "wardenInCharge": { "type": "string" },
        "status": { "type": "string", "enum": ["Recovering", "Resting", "Referred", "Discharged"] }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/schools/{schoolId}",
        "definition": { "entityName": "School", "schema": { "$ref": "#/backend/entities/School" }, "description": "Top-level collection for schools." }
      },
      {
        "path": "/schools/{schoolId}/assets/{assetId}",
        "definition": { "entityName": "Asset", "schema": { "$ref": "#/backend/entities/Asset" }, "description": "Inventory records." }
      },
      {
        "path": "/schools/{schoolId}/medicalRecords/{recordId}",
        "definition": { "entityName": "MedicalRecord", "schema": { "$ref": "#/backend/entities/MedicalRecord" }, "description": "Sickbay logs." }
      }
    ]
  }
}
