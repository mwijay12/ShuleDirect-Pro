
{
  "entities": {
    "School": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "School",
      "type": "object",
      "description": "Represents a school, which acts as a distinct tenant within the multi-tenant system.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "systemName": { "type": "string" },
        "address": { "type": "string" },
        "contactEmail": { "type": "string", "format": "email" },
        "contactPhone": { "type": "string" },
        "centerId": { "type": "string" },
        "region": { "type": "string" },
        "district": { "type": "string" },
        "logo": { "type": "string", "description": "Base64 encoded logo image" },
        "tiers": { 
          "type": "array", 
          "items": { "type": "string" },
          "description": "Active academic levels (e.g., Standard 7, Form 2)" 
        }
      },
      "required": ["id", "name"]
    },
    "Student": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Student",
      "type": "object",
      "description": "Represents a student enrolled in the institution.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "class": { "type": "string" },
        "status": { "type": "string" },
        "type": { "type": "string", "enum": ["Boarder", "Day"] },
        "contact": { "type": "string" },
        "attendance": { "type": "string" },
        "conductPoints": { "type": "number" },
        "hostel": { "type": "string" },
        "route": { "type": "string" },
        "photo": { "type": "string", "description": "Student profile photo URL/Base64" },
        "attendanceStatus": { "type": "string", "enum": ["Present", "Absent", "Late"] },
        "lastAttendanceUpdate": { "type": "string" },
        "performance": { "type": "string" },
        "totalFeesExpected": { "type": "number" },
        "totalPaid": { "type": "number" },
        "balance": { "type": "number" },
        "arrears": { "type": "number" }
      },
      "required": ["id", "name", "class"]
    },
    "Transaction": {
      "title": "Transaction",
      "type": "object",
      "description": "Forensic-grade financial transaction node.",
      "properties": {
        "id": { "type": "string" },
        "controlNumber": { "type": "string" },
        "transactionReference": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string", "default": "TZS" },
        "feeType": { "type": "string", "enum": ["Tuition", "Transport", "Boarding", "Exam Fee"] },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "class": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Verified", "Failed", "Disputed", "Refunded"] },
        "paymentMethod": { "type": "string", "enum": ["M-Pesa", "Tigo Pesa", "Airtel Money", "Bank Transfer", "Cash"] },
        "bankReference": { "type": "string" },
        "reconciled": { "type": "boolean" },
        "reconciledBy": { "type": "string" },
        "reconciledAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "recordedBy": { "type": "string" },
        "recordedFromIp": { "type": "string" },
        "deviceInfo": { "type": "string" },
        "disputed": { "type": "boolean" },
        "disputeReason": { "type": "string" },
        "receiptUrl": { "type": "string" }
      },
      "required": ["controlNumber", "amount", "studentId", "status"]
    },
    "PettyCashExpense": {
      "title": "PettyCashExpense",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "department": { "type": "string", "enum": ["Science Lab", "Sports", "Library", "Maintenance", "Transport", "Admin"] },
        "category": { "type": "string", "enum": ["Equipment", "Supplies", "Repairs", "Utilities", "Other"] },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected"] },
        "recordedBy": { "type": "string" },
        "approvedBy": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "schoolId": { "type": "string" }
      },
      "required": ["department", "category", "amount", "description"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/schools/{schoolId}",
        "definition": {
          "entityName": "School",
          "schema": { "$ref": "#/backend/entities/School" },
          "description": "Root tenant collection."
        }
      },
      {
        "path": "/schools/{schoolId}/students/{studentId}",
        "definition": {
          "entityName": "Student",
          "schema": { "$ref": "#/backend/entities/Student" },
          "description": "Unified student registry."
        }
      },
      {
        "path": "/schools/{schoolId}/transactions/{transactionId}",
        "definition": {
          "entityName": "Transaction",
          "schema": { "$ref": "#/backend/entities/Transaction" },
          "description": "Global institutional financial ledger."
        }
      },
      {
        "path": "/schools/{schoolId}/petty_cash/{expenseId}",
        "definition": {
          "entityName": "PettyCashExpense",
          "schema": { "$ref": "#/backend/entities/PettyCashExpense" },
          "description": "Departmental operational expenses ledger."
        }
      }
    ]
  }
}
